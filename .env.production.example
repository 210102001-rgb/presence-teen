# Presence Teen - Production .env Configuration
# Copy this file to .env on the production server and fill in your values
# IMPORTANT: Never commit .env to version control!

# ===================================================================
# APPLICATION SETTINGS
# ===================================================================

APP_NAME="Presence Teen"
APP_ENV=production
APP_KEY=base64:GENERATE_THIS_ON_SERVER
APP_DEBUG=false
APP_URL=https://presence.solvianova.my.id

# ===================================================================
# LOGGING
# ===================================================================

LOG_CHANNEL=single
LOG_STACK=single
LOG_LEVEL=error
LOG_SLACK_WEBHOOK_URL=

# ===================================================================
# DATABASE CONFIGURATION (Rumahweb MySQL)
# ===================================================================

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=solvianova_presence
DB_USERNAME=solvianova_presnc
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# ===================================================================
# SESSION CONFIGURATION
# ===================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.solvianova.my.id

# ===================================================================
# CACHE CONFIGURATION
# ===================================================================

CACHE_DRIVER=file
CACHE_STORE=file

# ===================================================================
# QUEUE CONFIGURATION
# ===================================================================

QUEUE_CONNECTION=database
QUEUE_FAILED_TABLE=failed_jobs

# ===================================================================
# MAIL CONFIGURATION (Rumahweb SMTP)
# ===================================================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.rumahweb.com
MAIL_PORT=465
MAIL_USERNAME=your_email@solvianova.my.id
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@solvianova.my.id"
MAIL_FROM_NAME="Presence Teen"

# ===================================================================
# BROADCAST SETTINGS
# ===================================================================

BROADCAST_DRIVER=log

# ===================================================================
# PUSHER SETTINGS (Optional)
# ===================================================================

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ===================================================================
# AWS SETTINGS (Optional)
# ===================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===================================================================
# VITE / ASSET COMPILATION
# ===================================================================

VITE_API_BASE_URL=${APP_URL}

# ===================================================================
# AI INTEGRATION (Claude API - Optional)
# ===================================================================

# If you want to use AI features, get these from Anthropic:
# https://console.anthropic.com/

AI_API_BASE_URL=https://api.anthropic.com/v1
AI_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
AI_MODEL=claude-3-5-sonnet-20241022
AI_VERSION=2023-06-01

# ===================================================================
# REDIS CONFIGURATION (Optional - for better caching)
# ===================================================================

# If Rumahweb provides Redis:
# REDIS_HOST=localhost
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_DRIVER=redis

# ===================================================================
# SECURITY & ADDITIONAL SETTINGS
# ===================================================================

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://presence.solvianova.my.id

# Rate limiting
THROTTLE=60:1

# Trailing slash
APP_TRAILING_SLASH=false

# Timezone
APP_TIMEZONE=Asia/Jakarta

# ===================================================================
# NOTE: Configure These After Setup
# ===================================================================

# Once deployed, you can optionally add:
# - Sentry error tracking
# - Analytics
# - Additional integrations
# - Custom environment variables

# ===================================================================
# INSTRUCTIONS
# ===================================================================

# 1. Copy this file to .env on the production server:
#    cp .env.production.example .env
#
# 2. Edit .env with your actual values:
#    - DB credentials from cPanel
#    - Email credentials
#    - API keys (if using)
#
# 3. Generate APP_KEY on the server:
#    php artisan key:generate
#
# 4. Never commit .env to version control
# 5. Keep .env secure (permissions 644)
# 6. Backup .env regularly
#
# ===================================================================
